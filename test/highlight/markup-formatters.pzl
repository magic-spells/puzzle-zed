<puzzle-view>
  <p>{ body | raw }</p>
  <!--        ^ function -->
  { note | trim | newline_to_br }
  <!--             ^ function -->
  {#if a}{ b | raw }{/if}
  <!--         ^ function -->
  <Card>{ d | raw }</Card>
  <!--        ^ function -->
  <textarea>{ e | raw }</textarea>
  <!--            ^ error -->
  { g | raw | upcase }
  <!--  ^ error -->
  { h | raw('x') }
  <!--  ^ error -->
  <p title={ i | raw }>k</p>
  <!--           ^ error -->
  <Card body={ l | raw } />
  <!--             ^ error -->
  <b class="x { m | newline_to_br }">n</b>
  <!--              ^ error -->
  <button @click={ p | q }>r</button>
  <!--                 ^ error -->
  { x | raw() }
  <!--  ^ function -->
  { y | newline_to_br( ) }
  <!--  ^ function -->
  { z | raw( 'x' ) }
  <!--  ^ error -->
</puzzle-view>
